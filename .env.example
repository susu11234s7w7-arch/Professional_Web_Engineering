# ==========================================
# DevPulse Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# Security & Authentication
# Replace with a high-entropy secret string (min 32 characters) in production
JWT_SECRET=devpulse_super_secret_jwt_key_change_in_production_32chars
JWT_EXPIRES_IN=7d

# Database Configuration
# Path to the SQLite database file
DATABASE_PATH=./data/devpulse.sqlite

# Client URL (for CORS whitelisting)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=10

